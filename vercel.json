{
  "buildCommand": null,
  "devCommand": null,
  "installCommand": null,
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/high/(.*)",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
